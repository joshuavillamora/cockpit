; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cockpit"
run/main_scene="res://scenes/ui/screens/loading_screen.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/GameManager.cs"
SceneFlow="*res://scripts/autoload/SceneFlow.cs"
SettingsManager="*res://scripts/autoload/SettingsManager.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="New Game Project"

[gui]

theme/custom="res://resources/ui_theme.tres"

